# Internal Notion integration token, shared with the "Convergence Labs Projects" hub page.
# Create at https://www.notion.so/profile/integrations, then share the hub page with it.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port the Cockpit UI is served on. The API listens on PORT + 1.
PORT=4200

# Leave ANTHROPIC_API_KEY UNSET. If it is set, the Agent SDK silently overrides
# your Claude Code subscription auth and bills API credits instead.
# ANTHROPIC_API_KEY=
