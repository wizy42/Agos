{
  "name": "cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "Cockpit \u2014 Convergence Labs Agent OS control plane",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preflight": "node scripts/doctor.mjs",
    "link-repos": "tsx apps/server/src/cli/link-repos.ts",
    "dev": "node scripts/dev.mjs",
    "dream": "tsx apps/server/src/cli/dream.ts",
    "librarian": "tsx apps/server/src/cli/librarian.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
